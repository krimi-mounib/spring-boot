    {
      "name": "02 - Atelier 5 - Contrats et paiements",
      "description": "Démonstration de lecture seule de Paiement et de création en cascade Contrat → Paiements.",
      "item": [
        {
          "name": "Lister les paiements",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/paiements",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer contrat avec 2 paiements (cascade)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/contrats",
            "description": "À lancer après la création d’une réservation. Les paiements sont créés via cascade à partir du contrat.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-10-26\",\n  \"montantTotal\": 480.0,\n  \"valide\": true,\n  \"reservation\": {\n    \"idReservation\": \"{{reservationId}}\"\n  },\n  \"paiements\": [\n    {\n      \"montant\": 150.0,\n      \"datePaiement\": \"2026-10-26\",\n      \"modePaiement\": \"CARTE\"\n    },\n    {\n      \"montant\": 330.0,\n      \"datePaiement\": \"2026-10-26\",\n      \"modePaiement\": \"VIREMENT\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const body = pm.response.json(); if (body.idContrat !== undefined) pm.collectionVariables.set(\"contratId\", body.idContrat); if (body.paiements && body.paiements.length) pm.collectionVariables.set(\"paymentId\", body.paiements[0].idPaiement); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les paiements après cascade",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/paiements",
            "description": "Vérifiez que les deux paiements créés avec le contrat figurent dans la réponse."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST paiement direct — refusé car lecture seule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
