    {
      "name": "03 - Atelier 6 - Mission 1 : Simuler un prix",
      "description": "Lancer une simulation puis vérifier qu’aucun paiement ni contrat n’a été créé.",
      "item": [
        {
          "name": "Simuler prix VIP + code BIENVENUE + carte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/simulations-prix",
            "description": "La réservation doit exister. La réponse donne la décomposition du tarif sans créer contrat ou paiement.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"typeClient\": \"VIP\",\n  \"codePromo\": \"BIENVENUE\",\n  \"modePaiement\": \"CARTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Aucun enregistrement\", function () { pm.expect(pm.response.json().persiste).to.eql(false); });",
                  "pm.test(\"Montant retourné\", function () { pm.expect(pm.response.json().montantFinal).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        },
